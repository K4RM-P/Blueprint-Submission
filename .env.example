# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Settings → API). New-style keys work: sb_publishable_… / sb_secret_…
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — used by supabase/seed.ts and the payment webhook. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL (QR codes and certificate links point here)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# true = /demo page with one-click sign-in + "Demo environment" banner
NEXT_PUBLIC_DEMO_MODE=true
# Password for all seeded demo accounts (generated; shown only on /demo in demo mode)
DEMO_PASSWORD=

# Payments: mock (default, no keys needed) or stripe (TEST MODE keys only: sk_test_…)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
